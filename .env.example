# Copy to .env for local development (npm run dev loads it automatically).
# Nothing here is required locally — the defaults work.

# Secret used to sign fetched posts (see lib/token.js). REQUIRED on Vercel — set it in the
# project settings, never in the repo. Locally, if this is unset, a random secret is created
# in .signing-secret (gitignored) the first time the app runs.
#   generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=

# Microsoft sign-in (TR tenant). Leave AZURE_CLIENT_ID unset to keep sign-in off locally.
# Hosted, all four are required. REDIRECT_URI = the app's address + /auth/callback.
# (Commented out so `cp .env.example .env` keeps sign-in off.)
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=replace-me
# REDIRECT_URI=https://example.invalid/auth/callback

# Set by docker-compose.yml: refuse to start without SIGNING_SECRET and sign-in.
# HOSTED=1

# Port and address for the server (defaults 5002, this Mac only). The container uses 0.0.0.0.
# PORT=5002
# HOST=127.0.0.1

# Load limits (lib/limits.js). Defaults suit a 1-2 CPU container.
# RENDER_CONCURRENCY=1      # videos rendered at the same time
# RENDER_QUEUE_MAX=8        # videos allowed to wait in line
# CARD_CONCURRENCY=2        # preview cards drawn at the same time
# API_PER_MINUTE=60         # API calls per person per minute
# RENDERS_PER_HOUR=30       # videos per person per hour

# Chromium to use instead of the installed Google Chrome (the container sets /usr/bin/chromium)
# CHROME_PATH=

# Use a specific ffmpeg binary instead of the one bundled with the ffmpeg-static package
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
