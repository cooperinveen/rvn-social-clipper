# Copy to .env for local development (npm run dev loads it automatically).
# Nothing here is required locally — the defaults work.

# Secret used to sign fetched posts (see lib/token.js). REQUIRED on Vercel — set it in the
# project settings, never in the repo. Locally, if this is unset, a random secret is created
# in .signing-secret (gitignored) the first time the app runs.
#   generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=

# Port for the local server (default 5002)
# PORT=5002

# Use a specific ffmpeg binary instead of the one bundled with the ffmpeg-static package
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
